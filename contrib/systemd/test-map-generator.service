[Unit]
Description=msmodeling multi-branch test_map generator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=msmodeling-map-generator
Group=msmodeling-test-map
WorkingDirectory=/opt/msmodeling-test-map-publisher
ExecStart=/opt/msmodeling-test-map-publisher/.venv/bin/python scripts/helpers/ci_gate/publish_test_maps.py --config /etc/msmodeling-test-map/publisher.json --workspace /var/lib/msmodeling-test-map --mode generate --interval 60
Restart=on-failure
RestartSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/msmodeling-test-map/generation
ReadWritePaths=/var/lib/msmodeling-test-map/uv-cache
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=UV_CACHE_DIR=/var/lib/msmodeling-test-map/uv-cache

[Install]
WantedBy=multi-user.target
